        <name>Recalculate Total from Spreadsheet</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[// Run the same calculation the business rule uses, for the record currently on screen
var result = new BudgetSpreadsheetTotal().recalculate(current.getUniqueValue());

// If no spreadsheet was found, tell the user rather than silently doing nothing
if (!result || result.files === 0) {
    // Show a yellow warning banner at the top of the form
    gs.addErrorMessage('No .xlsx spreadsheet is attached to this record.');
} else {
    // Show a green confirmation banner including the figures, so the user can sanity check
    gs.addInfoMessage('Total updated to ' + result.total.toFixed(2) +
                      ' from ' + result.rows + ' line item(s) across ' + result.files + ' file(s).');
}

// Reload the form so the refreshed total amount value is visible
action.setRedirectURL(current);]]></script>
