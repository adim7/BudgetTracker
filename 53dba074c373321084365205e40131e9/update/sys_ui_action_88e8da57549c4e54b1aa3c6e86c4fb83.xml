        <name>Submit for Approval</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[
        // Validate realignment before submission
        var validation = true;
        var errorMessages = [];
        
        // Check if there are line items
        var lineCount = new GlideAggregate('x_1962601_budget_t_realignment_line');
        lineCount.addQuery('realignment', current.sys_id);
        lineCount.addAggregate('COUNT');
        lineCount.query();
        
        if (lineCount.next() && lineCount.getAggregate('COUNT') == 0) {
            validation = false;
            errorMessages.push('Realignment must have at least one line item');
        }
        
        // Check for justification
        if (!current.justification || current.justification.toString().trim() === '') {
            validation = false;
            errorMessages.push('Justification is required for approval');
        }
        
        // Check for total amount
        if (!current.total_amount || parseFloat(current.total_amount) <= 0) {
            validation = false;
            errorMessages.push('Total amount must be greater than zero');
        }
        
        if (validation) {
            current.status = 'pending_approval';
            current.update();
            gs.addInfoMessage('Realignment submitted for approval successfully');
            action.setRedirectURL(current);
        } else {
            gs.addErrorMessage('Cannot submit for approval: ' + errorMessages.join('; '));
        }
    ]]></script>
