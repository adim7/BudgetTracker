        <content><![CDATA[import { gs, GlideRecord } from '@servicenow/glide'
import { calculateBudgetTotals } from './budget-calculations.js'

/**
 * Business rule script to update budget totals when allocations change
 */
export function updateBudgetTotals(current, previous) {
    // Get the budget record and update its totals
    const budgetGr = current.budget.getRefRecord();
    if (budgetGr && budgetGr.isValidRecord()) {
        calculateBudgetTotals(budgetGr);
    }
}]]></content>
